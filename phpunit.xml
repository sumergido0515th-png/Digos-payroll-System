<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">

  <!--
    Default target for the integration suite.

    TestDatabase reads the environment before app/config.php, and it refuses any
    database whose name lacks a "test" marker so a mis-set DB_NAME can never
    truncate live payroll data. Without this default it fell back to DB_NAME
    from config.php - the working database - and the guard turned all nine
    integration tests into errors, so in practice they never ran at all.

    An absent or unreachable database is still a skip, not a failure: a
    developer with no MySQL running can work on the unit suite. Override with
    `DB_NAME=... vendor/bin/phpunit` to point at a different test database.
  -->
  <php>
    <env name="DB_NAME" value="digos_payroll_test"/>
  </php>

  <testsuites>
    <!-- Pure logic + repo-structure guards. No database, no network. Always runnable. -->
    <testsuite name="architecture">
      <directory>tests/Architecture</directory>
    </testsuite>
    <testsuite name="unit">
      <directory>tests/Unit</directory>
    </testsuite>

    <!-- Requires a live MySQL/MariaDB test database (see tests/bootstrap.php). -->
    <testsuite name="integration">
      <directory>tests/Integration</directory>
    </testsuite>
  </testsuites>

  <source>
    <include>
      <directory>app</directory>
    </include>
  </source>
</phpunit>
