{
  "name": "digos/payroll-system",
  "description": "Digos City Government payroll management system with pre-audit control layer",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Digos\\Domain\\": "app/Domain/",
      "Digos\\Repo\\": "app/Repo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Digos\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:arch": "phpunit --testsuite architecture",
    "migrate": "php tools/migrate.php",
    "docs:schema": "php tools/generate-schema-doc.php"
  }
}
